name: Lumenia CI

on:
  push:
  pull_request:

jobs:
  windows:
    runs-on: windows-latest
    strategy:
      fail-fast: false
      matrix:
        python-version: ['3.11', '3.12', '3.13']
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
      - name: Configure MSVC x64
        uses: ilammy/msvc-dev-cmd@v1
        with:
          arch: x64
      - name: Install test and build dependencies
        run: python -m pip install -r requirements-dev.lock
      - name: Build native engine
        run: python scripts/build_native.py --simd scalar --force
      - name: Measure native engine baseline
        run: python benchmarks/run_engine_benchmarks.py --iterations 3 --canvas-size 256 --points 48 --output build/benchmarks/engine.json
      - name: Run executive test suite
        run: python tests/run_all_tests.py --coverage --coverage-minimum 80
      - name: Publish benchmark and coverage reports
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: engine-benchmark-py${{ matrix.python-version }}
          path: |
            build/benchmarks/engine.json
            build/coverage/document.json
