/* ================================================================
   1. GLOBAL & FONTES
   ================================================================ */
* {
    font-family: @FONT_FAMILY;
    font-size: 13px;
}

QWidget {
    background-color: @BG_DARKER;
    color: @FG_PRIMARY;
}

QLabel {
    background-color: transparent;
}

/* Propriedades Customizadas (Labels) */
QLabel[muted="true"] {
    color: @FG_SECONDARY;
}

QLabel[heading="true"] {
    color: @FG_PRIMARY;
    font-weight: 600;
}

QLabel[accent="true"] {
    color: @ACCENT;
}