/* ================================================================
   1. GLOBAL & FONTES
   ================================================================ */
* {
    font-family: @FONT_FAMILY;
    font-size: 13px;
}

QWidget {
    background-color: @BG_DARKER;
    color: @FG_PRIMARY;
}

QLabel {
    background-color: transparent;
}

/* Propriedades Customizadas (Labels) */
QLabel[muted="true"] {
    color: @FG_SECONDARY;
}

QLabel[heading="true"] {
    color: @FG_PRIMARY;
    font-weight: 600;
}

QLabel[accent="true"] {
    color: @ACCENT;
}

/* ToolTips (Balões de Dica Flutuantes) */
QToolTip {
    background-color: @BG_DARKEST;
    color: @FG_PRIMARY;
    border: 1px solid @BORDER_LIGHT;
    border-radius: @RADIUS_SMALL;
    padding: 4px 8px;
    font-size: 11px;
    font-family: @FONT_FAMILY;
}